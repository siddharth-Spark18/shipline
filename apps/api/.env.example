# --- Server ---
PORT=3000
# Public URL of this API (used in OAuth redirect URIs, MCP resource metadata, GitHub webhooks)
BACKEND_URL=http://localhost:3000
# Public URL of the web hub (CORS + post-login redirect)
CLIENT_URL=http://localhost:5173
HTTP_LOGGING=true

# --- Database ---
DATABASE_URL=postgresql://shipline:shipline@localhost:5432/shipline

# --- Secrets (generate with: openssl rand -hex 32) ---
JWT_SECRET=
# Encrypts Jira OAuth tokens at rest
ENCRYPTION_KEY=

# --- Google SSO (Google Cloud console > OAuth client, redirect: {BACKEND_URL}/api/auth/google/callback) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: only allow this Google Workspace domain (e.g. example.com)
GOOGLE_ALLOWED_DOMAIN=
# Comma-separated emails that become Shipline admins on first sign-in
ADMIN_EMAILS=

# --- GitHub account link (OAuth app, callback: {BACKEND_URL}/api/auth/github/callback) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- GitHub App (required check `shipline/gates`; webhook: {BACKEND_URL}/api/webhook/github) ---
GITHUB_APP_ID=
# PEM private key; newlines may be written as \n
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# --- Jira OAuth 2.0 (3LO), pull-only. Callback: {BACKEND_URL}/api/jira/callback. Scopes: read:jira-work read:me offline_access ---
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=

# --- MCP / OAuth authorization server ---
# Access token lifetime in seconds
OAUTH_ACCESS_TOKEN_TTL=3600
# Extra allowed redirect URIs for dynamically registered MCP clients (comma-separated patterns, optional)
MCP_EXTRA_REDIRECT_URIS=

# --- Artifacts (OPEN-QUESTION #7) ---
MAX_ARTIFACT_BYTES=1048576

# --- Plugin version advertised to Shipline Local ---
LATEST_PLUGIN_VERSION=0.1.0
