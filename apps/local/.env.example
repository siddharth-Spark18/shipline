# Shipline hub API this Local app signs in to (no secrets here: Shipline Local holds no Claude credentials).
SHIPLINE_API_URL=http://localhost:3000
# Local server port (0 = pick a free port)
SHIPLINE_LOCAL_PORT=4777
# Override the claude binary (default: `claude` on PATH). Always the user's own installed CLI.
# SHIPLINE_CLAUDE_BIN=
# Dev only: extra allowed browser origin for the Vite dev server
# SHIPLINE_LOCAL_DEV_ORIGIN=http://127.0.0.1:5174
