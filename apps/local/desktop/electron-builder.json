{
  "appId": "com.shipline.local",
  "productName": "Shipline Local",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**",
    "plugin/**",
    "desktop/main.cjs",
    "desktop/tray-icon.png",
    "package.json"
  ],
  "npmRebuild": true,
  "mac": {
    "category": "public.app-category.developer-tools",
    "hardenedRuntime": true,
    "notarize": true,
    "target": [
      "dmg",
      "zip"
    ]
  },
  "win": {
    "target": [
      "nsis"
    ]
  },
  "linux": {
    "target": [
      "AppImage"
    ]
  }
}
