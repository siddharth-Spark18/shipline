{
  "name": "@forgeyard/shipline",
  "version": "0.7.0",
  "description": "Install a repo-committed Claude Code workflow (stages, rules, enforcement hooks, task artifacts stored outside the repo) with `npx @forgeyard/shipline init`.",
  "type": "module",
  "bin": {
    "shipline": "bin/shipline.mjs"
  },
  "files": [
    "bin",
    "src",
    "templates",
    "ui-dist"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs test/ui/*.test.mjs",
    "test:hooks": "node --test test/*.test.mjs",
    "prepack": "node scripts/build-ui.mjs",
    "check:ui": "node scripts/check-ui.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/siddharth-Spark18/shipline.git",
    "directory": "packages/cli"
  }
}
