{
  "permissions": {
    "allow": ["Read(~/.shipline/**)", "Edit(~/.shipline/**)", "Bash(node .shipline/bin/stage.mjs:*)"]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [{ "type": "command", "command": "command -v node >/dev/null 2>&1 && node \"$CLAUDE_PROJECT_DIR/.shipline/bin/session-start.mjs\" || echo '{\"systemMessage\":\"Shipline needs Node.js 18 or newer on this machine; its workflow hooks are off until it'\\''s installed.\"}'" }]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [{ "type": "command", "command": "command -v node >/dev/null 2>&1 && node \"$CLAUDE_PROJECT_DIR/.shipline/bin/prompt-submit.mjs\" || true" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [{ "type": "command", "command": "command -v node >/dev/null 2>&1 && node \"$CLAUDE_PROJECT_DIR/.shipline/bin/record-answer.mjs\" || true" }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [{ "type": "command", "command": "command -v node >/dev/null 2>&1 && node \"$CLAUDE_PROJECT_DIR/.shipline/bin/guard.mjs\" || true" }]
      }
    ]
  }
}
