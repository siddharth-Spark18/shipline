{
  "permissions": {
    "allow": ["Read(~/.shipline/**)", "Edit(~/.shipline/**)"]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.shipline/bin/session-start.mjs\"" }]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.shipline/bin/prompt-submit.mjs\"" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.shipline/bin/record-answer.mjs\"" }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.shipline/bin/guard.mjs\"" }]
      }
    ]
  }
}
